{
  "name": "mams-server",
  "version": "1.0.0",
  "private": true,
  "description": "Military Asset Management System API",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
