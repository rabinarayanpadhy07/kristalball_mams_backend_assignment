NODE_ENV=development
PORT=4000
# LOG_LEVEL=debug              # default: debug (development), info (production), silent (test)
# TRUST_PROXY=1                # number of reverse-proxy hops in front of the API

# MySQL 8 connection for a DEVELOPMENT database.
# - Local server: add ?allowPublicKeyRetrieval=true if the user uses caching_sha2_password without TLS.
# - Managed/cloud server (e.g. Aiven): keep ?ssl-mode=REQUIRED and set DATABASE_SSL_CA below.
DATABASE_URL="mysql://mams_dev:CHANGE_ME@localhost:3306/mams_dev"
DATABASE_POOL_SIZE=10

# Path to the server's CA certificate (Aiven: Service overview → "CA certificate" → save as certs/ca.pem).
# When set, the app verifies the server certificate instead of only encrypting.
# DATABASE_SSL_CA=certs/ca.pem

# Auth — generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# COOKIE_SECURE=true           # default: true in production (requires HTTPS)

# Comma-separated browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_MAX=10

# Integration tests: this database is DROPPED and recreated on every `npm test`.
# The name must end in _test.
TEST_DATABASE_URL="mysql://mams_dev:CHANGE_ME@localhost:3306/mams_test"

# Optional: password given to every seeded DEVELOPMENT account.
# Defaults to the value printed by the seed script. Never reuse a real password here.
SEED_DEV_PASSWORD=
